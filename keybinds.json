{
  "input": {
    "//comment0": "The current avaliable input modes are 'infrared', 'ble' and 'none'",
    "mode": "BLE",
    "pairController": true,
    "maxBleDevices": 1,
    "drivers": ["panda", "hid", "BLE-M3", "beauty-r1"]
  },
  "infrared": [
    {
      "//comment": "Generic controller",
      "usercode": "FF00",
      "bind": {
        "B9": "press(BUTTON_UP)",
        "EA": "press(BUTTON_DOWN)",
        "BB": "press(BUTTON_LEFT)", 
        "BC": "press(BUTTON_RIGHT)",
        "BF": "press(BUTTON_CONFIRM)",
        "E6": "press(BUTTON_BACK)",
        "BA": "press(BUTTON_AUX_A)",
        "F3": "setRainbowShader(true)",
        "E7": "setRainbowShader(false)",
        "F7": "expressions.Next()",
        "E3": "expressions.Previous()",
        "A5": "press(BUTTON_BACK, 1)"
      }
    }
  ],
  "keybinds": {
    "panda.buttons.1": "BUTTON_LEFT",
    "panda.buttons.2": "BUTTON_DOWN",
    "panda.buttons.3": "BUTTON_RIGHT",
    "panda.buttons.4": "BUTTON_UP",
    "panda.buttons.5": "BUTTON_CONFIRM",
    "panda.buttons.6": "BUTTON_BACK",
    "panda.buttons.7": "BUTTON_AUX_A",
    "panda.buttons.8": "BUTTON_AUX_B",

    "joystick.hat_left=1":  "BUTTON_LEFT",
    "joystick.hat_down=1":  "BUTTON_DOWN",
    "joystick.hat_right=1": "BUTTON_RIGHT",
    "joystick.hat_up=1":    "BUTTON_UP",
    
    "joystick.button&1": "BUTTON_CONFIRM",
    "joystick.button&4": "BUTTON_BACK",

    "joystick.left_analog_x<-10": "BUTTON_LEFT",
    "joystick.left_analog_y>10": "BUTTON_DOWN",
    "joystick.left_analog_x>10": "BUTTON_RIGHT",
    "joystick.left_analog_y<-7": "BUTTON_UP",


    "consumer.button=Fast Forward": "BUTTON_UP",
    "consumer.button=Rewind": "BUTTON_DOWN",
    "consumer.button=Next Track": "BUTTON_RIGHT",
    "consumer.button=Previous Track": "BUTTON_LEFT",
    "consumer.button=PlayPause": "BUTTON_CONFIRM",
    "consumer.button=Menu": "BUTTON_BACK",
    "consumer.button=Volume Up": "BUTTON_UP",
    "consumer.button=Volume Down": "BUTTON_DOWN",


    "keyboard.button=Up": "BUTTON_UP",
    "keyboard.button=Down": "BUTTON_DOWN",
    "keyboard.button=Left": "BUTTON_LEFT",
    "keyboard.button=Right": "BUTTON_RIGHT",
    "keyboard.button=Enter": "BUTTON_CONFIRM",
    "keyboard.button=Esc": "BUTTON_BACK",
    
    "mouse.x>10": "BUTTON_LEFT",
    "mouse.x<-10": "BUTTON_RIGHT",
    "mouse.y<-10": "BUTTON_UP",
    "mouse.y>10": "BUTTON_DOWN",
    "mouse.buttons.1": "BUTTON_CONFIRM",
    "mouse.buttons.4": "BUTTON_BACK"
  }
}